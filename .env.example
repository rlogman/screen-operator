# Copiar a .env (ignorado por git) y completar. Nunca commitear valores reales.
# Escritorio de pruebas (tarjeta "Tu entorno" en /evento): URL del websocket, contraseña y token.
SO_DESKTOP_URL=wss://<tu-escritorio>/websockify
SO_DESKTOP_PASSWORD=
SO_DESKTOP_TOKEN=
# Key personal de OpenRouter (pestaña Herramientas del evento).
OPENROUTER_API_KEY=
# Token del equipo (entrypoint). Lo usa el agente para autenticar llamadas entrantes.
TEAM_TOKEN=

flowchart LR
  eval["<b>Evaluador</b><br/>[Persona / sistema externo]<br/>Envía tareas en lenguaje natural<br/>y consulta el resultado"]
  so["<b>Screen Operator</b><br/>[Sistema de software]<br/>Agente que aprende a operar apps<br/>sin API, solo por pantalla"]
  desk["<b>Escritorio remoto</b><br/>[Sistema externo]<br/>Navegador kiosko 1280x800 con la app<br/>legada (SIGECOM o desconocida), solo VNC"]
  llm["<b>OpenRouter</b><br/>[Sistema externo]<br/>Modelos multimodales<br/>(presupuesto US$ 50)"]
  team["<b>Equipo</b><br/>[Persona]<br/>Ajusta configuración<br/>y mide con el harness"]

  eval -- "POST /tasks, GET /tasks/{id}<br/>[HTTPS + Bearer]" --> so
  so -- "Ve píxeles, envía mouse y teclado<br/>[RFB sobre WSS]" --> desk
  so -- "Captura + historial → próxima acción<br/>[HTTPS, chat completions]" --> llm
  team -- "Edita YAML, corre pruebas<br/>[git / CLI]" --> so
  team -. "/__reset, /__check<br/>[HTTPS + token escritorio]" .-> desk

  classDef person fill:#08427b,color:#fff,stroke:#052e56
  classDef sys fill:#1168bd,color:#fff,stroke:#0b4884
  classDef ext fill:#999,color:#fff,stroke:#6b6b6b
  class eval,team person
  class so sys
  class desk,llm ext
